<Application x:Class="QuickClip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- 必须在 WPF-UI 之后合并，覆盖其/系统默认白槽滚动条 -->
                <ResourceDictionary Source="Themes/ThemeScrollBar.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="Theme.FontFamily">Segoe UI, Microsoft YaHei UI, Microsoft YaHei, sans-serif</FontFamily>
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<ui:FluentWindow x:Class="QuickClip.Views.SnippetQuickAdjustWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="微调填入"
                  Width="480" Height="380"
                  WindowStartupLocation="CenterScreen"
                  Topmost="True"
                  ResizeMode="CanResizeWithGrip"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None"
                  Background="{DynamicResource Theme.Panel}"
                  BorderBrush="{DynamicResource Theme.Border}"
                  BorderThickness="1"
                  KeyDown="OnWindowKeyDown">

    <Grid Background="{DynamicResource Theme.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Title="微调填入"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <Grid Grid.Row="1" Margin="20,10,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 提示信息 -->
            <TextBlock Grid.Row="0"
                       Margin="0,0,0,8"
                       FontSize="11.5"
                       Foreground="{DynamicResource Theme.TextSecondary}"
                       TextWrapping="Wrap"
                       Text="在此临时调整短语内容（保留占位符，粘贴时动态替换）。" />

            <!-- 正文编辑区 -->
            <TextBox x:Name="ContentBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="10"
                     FontSize="12.5"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     Background="{DynamicResource Theme.Search}"
                     BorderBrush="{DynamicResource Theme.Border}"
                     BorderThickness="1"
                     Foreground="{DynamicResource Theme.Text}"
                     CaretBrush="{DynamicResource Theme.Text}"
                     PreviewKeyDown="OnContentBoxPreviewKeyDown" />
        </Grid>

        <!-- 底部操作按钮 -->
        <Border Grid.Row="2"
                Background="{DynamicResource Theme.Search}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Secondary"
                           Content="取消"
                           Width="68"
                           Margin="0,0,8,0"
                           Click="OnCancelClicked" />

                <ui:Button Appearance="Secondary"
                           Content="复制"
                           Width="68"
                           Margin="0,0,8,0"
                           ToolTip="将修改后的内容复制到剪贴板，不自动粘贴"
                           Click="OnCopyOnlyClicked" />

                <ui:Button x:Name="SaveButton"
                           Appearance="Secondary"
                           Content="保存"
                           Width="68"
                           Margin="0,0,8,0"
                           ToolTip="将修改后的内容保存回常用短语模板"
                           Click="OnSaveClicked" />

                <ui:Button x:Name="ApplyPasteButton"
                           Appearance="Secondary"
                           Content="粘贴"
                           Width="68"
                           Height="32"
                           FontWeight="SemiBold"
                           BorderBrush="{DynamicResource Theme.Accent}"
                           BorderThickness="1"
                           Foreground="{DynamicResource Theme.Accent}"
                           ToolTip="解析占位符并立即自动粘贴到目标页面"
                           Click="OnApplyAndPasteClicked" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

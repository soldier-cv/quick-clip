<!--
  设置窗不用 FluentWindow：其默认铬/客户区在部分环境下会露白边、白槽。
  改用普通 Window + WindowChrome 自绘标题栏，客户区全程 Theme.Panel。
-->
<Window x:Class="QuickClip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuickClip 设置"
        Width="540"
        Height="720"
        MinWidth="400"
        MinHeight="420"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Theme.Panel}"
        BorderBrush="{DynamicResource Theme.Border}"
        BorderThickness="1"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 单层外框：避免 Window + 内 Border 双边框吃高度/露色带 -->
    <Grid x:Name="RootGrid" Background="{DynamicResource Theme.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（可拖拽；关闭钮排除在标题拖拽区外） -->
        <Grid Grid.Row="0" Background="{DynamicResource Theme.Panel}">
            <TextBlock Text="QuickClip 设置"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Text}" />
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="46"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnCloseClicked"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="关闭">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Theme.TextSecondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FF4444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!--
          双列主题 ScrollViewer：内容撑高（如 OCR 引擎面板展开）时 extent 跟随，
          滚动条列 Auto 宽（约 6px，隐藏时为 0），不再留死白/黑条。
        -->
        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="1"
                      Background="{DynamicResource Theme.Panel}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="22,8,12,28"
                      CanContentScroll="False"
                      Focusable="False"
                      Template="{StaticResource ThemeOverlayScrollViewer}">
            <StackPanel Background="{DynamicResource Theme.Panel}"
                        Margin="0,0,0,12">

                <!-- ========== 快捷键 ========== -->
                <!-- ========== 外观 ========== -->
                <TextBlock Text="外观"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,8,0,10" />
                <Border Padding="16,14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeBox"
                                      Grid.Column="1"
                                      Height="36"
                                      SelectionChanged="OnThemeChanged"
                                      PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="16" Height="16"
                                                    CornerRadius="4"
                                                    Margin="0,0,10,0"
                                                    BorderBrush="{DynamicResource Theme.Border}"
                                                    BorderThickness="1"
                                                    Background="{Binding Swatch}" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Theme.Text}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="快捷键"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10" />

                <Border Padding="0"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>

                        <!-- 分区：全局 -->
                        <TextBlock Text="全局"
                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="16,14,16,6" />

                        <!-- Win+V 锁定 -->
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="唤起 / 隐藏面板"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Height="34"
                                     Padding="10,0"
                                     IsReadOnly="True"
                                     IsEnabled="False"
                                     VerticalContentAlignment="Center"
                                     Text="Win + V" />
                            <Border Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Padding="8,4"
                                    CornerRadius="6"
                                    Background="{DynamicResource Theme.AccentMuted}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="锁定"
                                           Foreground="{DynamicResource Theme.Accent}"
                                           FontSize="11" />
                            </Border>
                        </Grid>

                        <!-- 系统剪贴板冲突与接管管理（标准三列对齐） -->
                        <Grid Margin="16,4,16,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="系统剪贴板冲突"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Height="34"
                                    Padding="10,0"
                                    CornerRadius="4"
                                    Background="{DynamicResource Theme.Search}"
                                    BorderBrush="{DynamicResource Theme.Border}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="SysClipboardStatusBadge"
                                            Padding="6,2"
                                            CornerRadius="4"
                                            Background="{DynamicResource Theme.AccentMuted}"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="SysClipboardStatusText"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.Accent}"
                                                   Text="原生独占接管中" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ui:Button x:Name="ToggleSysClipboardButton"
                                       Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="12,0"
                                       Content="一键禁用"
                                       Click="OnToggleSysClipboardClicked" />
                        </Grid>
                        <TextBlock x:Name="SysClipboardHintText"
                                   Margin="184,2,16,6"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   FontSize="11.5"
                                   LineHeight="16"
                                   TextWrapping="Wrap"
                                   Text="Windows 剪贴板历史正在占用 Win+V。点击「一键禁用」可彻底释放快捷键。" />

                        <Rectangle Height="1" Fill="#12FFFFFF" Margin="16,8,16,8" />

                        <!-- 全局纯文本粘贴 -->
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="全局纯文本粘贴"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="PlainPasteBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="10,0"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="Transparent"
                                     Tag="PlainPaste"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus" />
                        </Grid>
                        <CheckBox x:Name="PlainPasteEnabledCheck"
                                  Margin="184,2,16,4"
                                  Foreground="{DynamicResource Theme.TextSecondary}"
                                  FontSize="12"
                                  Content="启用此全局热键"
                                  Checked="OnPlainPasteEnabledToggled"
                                  Unchecked="OnPlainPasteEnabledToggled" />

                        <!-- 分区：面板内 -->
                        <Rectangle Height="1" Fill="#12FFFFFF" Margin="16,10,16,4" />
                        <TextBlock Text="面板内"
                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="16,8,16,6" />

                        <!-- 粘贴选中 -->
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="粘贴选中项"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="PasteSelectedBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="10,0"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="Transparent"
                                     Tag="PasteSelected"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus" />
                            <ui:Button Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="12,0"
                                       Content="默认"
                                       Tag="PasteSelected"
                                       Click="OnResetHotkeyClicked" />
                        </Grid>

                        <!-- 纯文本粘贴选中 -->
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="纯文本粘贴选中项"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="PasteSelectedPlainBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="10,0"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="Transparent"
                                     Tag="PasteSelectedPlain"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus" />
                            <ui:Button Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="12,0"
                                       Content="默认"
                                       Tag="PasteSelectedPlain"
                                       Click="OnResetHotkeyClicked" />
                        </Grid>

                        <!-- 窗口置顶（产品热键，可改） -->
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="窗口置顶 / 取消"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="TogglePinBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="10,0"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="Transparent"
                                     Tag="TogglePin"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus" />
                            <ui:Button Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="12,0"
                                       Content="默认"
                                       Tag="TogglePin"
                                       Click="OnResetHotkeyClicked" />
                        </Grid>

                        <!-- 仅在捕获快捷键出错 / 成功改绑时显示 -->
                        <TextBlock x:Name="HotkeyHintText"
                                   Margin="16,6,16,14"
                                   Foreground="{DynamicResource Theme.Accent}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ========== 通用 ========== -->
                <TextBlock Text="通用"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10" />
                <Border Padding="16,14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartCheck"
                                  Foreground="{DynamicResource Theme.TextSecondary}"
                                  FontSize="13"
                                  Content="开机自启动"
                                  Checked="OnAutoStartToggled"
                                  Unchecked="OnAutoStartToggled" />
                        <CheckBox x:Name="AutoCheckUpdatesCheck"
                                  Margin="0,10,0,0"
                                  Foreground="{DynamicResource Theme.TextSecondary}"
                                  FontSize="13"
                                  Content="自动检查并下载更新"
                                  Checked="OnAutoCheckUpdatesToggled"
                                  Unchecked="OnAutoCheckUpdatesToggled" />
                    </StackPanel>
                </Border>

                <!-- ========== OCR：下拉选引擎，默认系统离线 ========== -->
                <TextBlock Text="OCR 识别"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10" />
                <Border Padding="16,14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="识别引擎"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="OcrEngineBox"
                                      Grid.Column="1"
                                      Height="34"
                                      SelectionChanged="OnOcrEngineChanged"
                                      PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                <ComboBoxItem Content="系统自带（离线）" />
                                <ComboBoxItem Content="Ollama" />
                                <ComboBoxItem Content="OpenAI" />
                            </ComboBox>
                        </Grid>

                        <StackPanel x:Name="OllamaPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="接口地址"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="OllamaBaseUrlBox"
                                         Grid.Column="1"
                                         Height="34"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         LostFocus="OnOllamaConfigLostFocus" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="视觉模型"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="OllamaModelBox"
                                         Grid.Column="1"
                                         Height="34"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         LostFocus="OnOllamaConfigLostFocus" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="OpenAiPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="接口地址"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="OpenAiBaseUrlBox"
                                         Grid.Column="1"
                                         Height="34"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         LostFocus="OnOpenAiConfigLostFocus" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="视觉模型"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="OpenAiModelBox"
                                         Grid.Column="1"
                                         Height="34"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         LostFocus="OnOpenAiConfigLostFocus" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <PasswordBox x:Name="OpenAiApiKeyBox"
                                             Grid.Column="1"
                                             Height="34"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             LostFocus="OnOpenAiConfigLostFocus" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="OcrTestPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="OcrTestButton"
                                           Appearance="Secondary"
                                           Height="34"
                                           Padding="14,0"
                                           Content="测试接口"
                                           Click="OnOcrTestClicked" />
                            </StackPanel>
                            <TextBlock x:Name="OcrTestStatus"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 高级 ========== -->
                <TextBlock Text="高级"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10" />
                <Border Padding="16,14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="TextOnlyCheck"
                                  Foreground="{DynamicResource Theme.TextSecondary}"
                                  FontSize="13"
                                  Content="仅记录文本（忽略图片/文件）"
                                  Checked="OnTextOnlyToggled"
                                  Unchecked="OnTextOnlyToggled" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最大条数"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="MaxHistoryBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     LostFocus="OnMaxHistoryLostFocus" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== 关于 ========== -->
                <TextBlock Text="关于"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10" />
                <Border Padding="16,14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="QuickClip · 版本 "
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="VersionText"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ChannelText"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   FontSize="12" />
                        <TextBlock x:Name="UpdateStatusText"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Appearance="Secondary"
                                       Height="34"
                                       Padding="14,0"
                                       Content="打开数据目录"
                                       Click="OnOpenDataFolderClicked" />
                            <ui:Button x:Name="CheckUpdateButton"
                                       Margin="10,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="14,0"
                                       Content="检查更新…"
                                       Click="OnCheckUpdateClicked" />
                            <ui:Button x:Name="InstallUpdateButton"
                                       Margin="10,0,0,0"
                                       Appearance="Primary"
                                       Height="34"
                                       Padding="14,0"
                                       Content="立即更新"
                                       Visibility="Collapsed"
                                       Click="OnInstallUpdateClicked" />
                            <ui:Button x:Name="BrowserDownloadButton"
                                       Margin="10,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="14,0"
                                       Content="在浏览器中下载"
                                       Visibility="Collapsed"
                                       Click="OnBrowserDownloadClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

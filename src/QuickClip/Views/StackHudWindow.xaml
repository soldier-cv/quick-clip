<Window x:Class="QuickClip.Views.StackHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="收集栈"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="320" Height="100"
        WindowStartupLocation="Manual"
        KeyDown="OnWindowKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <Grid Margin="8">
        <Border Background="{DynamicResource Theme.Panel}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.3" />
            </Border.Effect>

            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部状态行 -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Layer24" FontSize="14" Foreground="{DynamicResource Theme.Accent}" Margin="0,0,6,0" />
                        <TextBlock Text="收集栈 (连贴模式)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" />
                        <Border Margin="8,0,0,0" Padding="6,1" Background="{DynamicResource Theme.Search}" CornerRadius="4">
                            <TextBlock x:Name="CountBadge" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" Text="0 项" />
                        </Border>
                    </StackPanel>

                    <ui:Button Appearance="Transparent"
                               Padding="4,2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               CornerRadius="4"
                               ToolTip="退出收集栈 (Esc)"
                               Click="OnExitClicked">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="{DynamicResource Theme.TextSecondary}" />
                    </ui:Button>
                </Grid>

                <!-- 下一项出栈预览 -->
                <TextBlock x:Name="NextItemPreview"
                           Grid.Row="1"
                           Margin="0,4,0,0"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Theme.TextSecondary}"
                           Text="复制内容将自动排队，Ctrl + V 顺次粘贴" />

                <!-- 底部操作按钮 -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:Button Appearance="Secondary"
                                   Padding="6,2"
                                   FontSize="11"
                                   CornerRadius="4"
                                   ToolTip="将当前剪贴板多行文本拆分成多项入栈"
                                   Click="OnSplitLinesClicked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SplitVertical24" FontSize="12" Margin="0,0,4,0" />
                                <TextBlock Text="按行拆分" FontSize="11" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Appearance="Secondary"
                                   Margin="6,0,0,0"
                                   Padding="6,2"
                                   FontSize="11"
                                   CornerRadius="4"
                                   ToolTip="清空栈内全部条目"
                                   Click="OnClearClicked">
                            <TextBlock Text="清空" FontSize="11" />
                        </ui:Button>
                    </StackPanel>

                    <TextBlock Text="按 Esc 退出"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.TextSecondary}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

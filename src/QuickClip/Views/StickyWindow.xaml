<Window x:Class="QuickClip.Views.StickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="贴图置顶"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseWheel="OnMouseWheel">

    <Window.Resources>
        <ContextMenu x:Key="StickyContextMenu">
            <MenuItem Header="复制到剪贴板" Click="OnMenuCopyClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MenuSaveAs" Header="另存为..." Click="OnMenuSaveAsClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Save24" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MenuResetZoom" Header="100% 原始比例" Click="OnMenuResetZoomClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="不透明度 100%" Click="OnMenuOpacity100Clicked" />
            <MenuItem Header="不透明度 75%" Click="OnMenuOpacity75Clicked" />
            <MenuItem Header="不透明度 50%" Click="OnMenuOpacity50Clicked" />
            <Separator />
            <MenuItem Header="关闭 (Esc / 双击)" Click="OnMenuCloseClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="MainBorder"
                Background="{DynamicResource Theme.Panel}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1"
                CornerRadius="8"
                ContextMenu="{StaticResource StickyContextMenu}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.35" />
            </Border.Effect>

            <Grid>
                <!-- 图片模式容器 -->
                <Grid x:Name="ImageContainer" Visibility="Collapsed" MouseLeftButtonDown="OnImageContainerDoubleClicked">
                    <Image x:Name="StickyImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />
                    <!-- 浮动提示：缩放比与透明度 -->
                    <Border x:Name="ZoomBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="8"
                            Padding="6,2"
                            Background="#88000000"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ZoomBadgeText"
                                   FontSize="11"
                                   Foreground="#FFFFFF"
                                   Text="100%" />
                    </Border>
                </Grid>

                <!-- 文本便签模式容器 -->
                <Grid x:Name="TextContainer" Width="360" Height="260" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 便签标题栏 -->
                    <Border Grid.Row="0" Background="{DynamicResource Theme.Search}" CornerRadius="8,8,0,0" MouseLeftButtonDown="OnMouseLeftButtonDown">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <ui:SymbolIcon Symbol="Note24" FontSize="14" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,6,0" />
                                <TextBlock Text="便签置顶" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                <ui:Button Appearance="Transparent"
                                           Padding="4,2"
                                           CornerRadius="4"
                                           ToolTip="关闭 (Esc)"
                                           Click="OnCloseButtonClicked">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="{DynamicResource Theme.TextSecondary}" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 便签正文 -->
                    <TextBox x:Name="StickyTextBox"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10"
                             FontSize="13"
                             FontFamily="Consolas, Microsoft YaHei UI, Segoe UI"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Theme.Text}"
                             CaretBrush="{DynamicResource Theme.Text}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

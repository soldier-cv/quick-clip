<ui:FluentWindow x:Class="QuickClip.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:QuickClip.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
                 Title="QuickClip"
                 Width="460" Height="780"
                 WindowStartupLocation="Manual"
                 ShowInTaskbar="False"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource Theme.Panel}"
                 BorderBrush="{DynamicResource Theme.Border}"
                 BorderThickness="1"
                 KeyDown="OnWindowKeyDown"
                 SourceInitialized="OnSourceInitialized"
                 Closing="OnWindowClosing"
                 Deactivated="OnWindowDeactivated">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource Theme.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                 Title="QuickClip"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True"
                     CloseClicked="OnTitleBarCloseClicked">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="PinWindowButton"
                               Appearance="Transparent"
                               Padding="4,2"
                               Margin="0,0,2,0"
                               CornerRadius="6"
                               ToolTip="窗口置顶（前端固定），失焦不隐藏"
                               Click="OnPinWindowClicked">
                        <ui:SymbolIcon x:Name="PinWindowIcon"
                                       Symbol="Pin24"
                                       FontSize="15"
                                       Foreground="{DynamicResource Theme.TextSecondary}" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               Padding="4,2"
                               Margin="0,0,2,0"
                               CornerRadius="6"
                               ToolTip="设置…"
                               Click="OnSettingsClicked">
                        <ui:SymbolIcon Symbol="Settings24"
                                       FontSize="15"
                                       Foreground="{DynamicResource Theme.Text}" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 搜索与筛选 -->
        <Grid Grid.Row="1" Margin="16,6,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="SearchBox"
                        Grid.Column="0"
                        Height="36"
                        Padding="12,4"
                        VerticalContentAlignment="Center"
                        PlaceholderText="搜索剪贴板（支持关键词 / 拼音首字母）…"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Background="{DynamicResource Theme.Search}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1"
                        Foreground="{DynamicResource Theme.Text}" />

            <ComboBox Grid.Column="1"
                      Width="92"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      SelectedIndex="{Binding FilterIndex}"
                      Background="{DynamicResource Theme.Search}"
                      BorderBrush="{DynamicResource Theme.Border}"
                      Foreground="{DynamicResource Theme.Text}">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="文本" />
                <ComboBoxItem Content="图片" />
                <ComboBoxItem Content="链接" />
            </ComboBox>

            <ui:Button Grid.Column="2"
                       Margin="8,0,0,0"
                       Height="36"
                       MinWidth="36"
                       Padding="8,0"
                       Appearance="Transparent"
                       CornerRadius="8"
                       ToolTip="清空列表（删除全部非置顶，置顶保留）"
                       Click="OnClearListClicked">
                <ui:SymbolIcon Symbol="Delete24"
                               FontSize="15"
                               Foreground="{DynamicResource Theme.TextSecondary}" />
            </ui:Button>
        </Grid>

        <!-- 卡片列表 + 空状态 -->
        <Grid Grid.Row="2" Margin="12,4,12,2">
        <ListBox x:Name="ItemList"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 Visibility="{Binding ListVisibility}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 SelectionMode="Single"
                 MouseLeftButtonDown="OnItemListMouseLeftButtonDown"
                 MouseDoubleClick="OnItemListDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!-- 保留 IsSelected 供卡片 DataTrigger 绑定 -->
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ClipboardItemViewModel}">
                    <!--
                      用 Border 而非 ui:Card：完全自控 Background/Border，
                      悬停/选中用各主题专用色（Theme.CardHover / CardSelected），
                      选中 = 强调色整圈边框 + 选中底 + 左侧条，序号保持中性。
                    -->
                    <Border x:Name="ItemCard"
                            Margin="2,4"
                            Padding="0"
                            CornerRadius="12"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5"
                            MouseEnter="OnCardMouseEnter"
                            MouseLeave="OnCardMouseLeave">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-2"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0"
                                                         Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Theme.Card}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <!-- 仅置顶（未选中）：整圈置顶金色边框 -->
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Pin}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                    <!-- 普通悬停（未选中、未置顶）：专用悬停底 + 更强边框 -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                            <Condition Binding="{Binding IsPinned}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardHover}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </MultiDataTrigger>
                                    <!-- 置顶悬停（未选中、置顶）：专用悬停底 + 置顶金边框 -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                            <Condition Binding="{Binding IsPinned}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardHover}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Pin}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </MultiDataTrigger>
                                    <!-- 选中：主题强调色整圈霓虹边框 + 专用选中底 -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardSelected}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                    <!-- 选中 + 悬停：保持选中态，边框略加强调 -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardSelected}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="14,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 序号：始终中性 Badge，选中不染色 -->
                                    <Border Width="20" Height="20"
                                            CornerRadius="6"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Theme.Badge}">
                                        <TextBlock Text="{Binding IndexText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Theme.TextSecondary}" />
                                    </Border>

                                    <ui:SymbolIcon Grid.Column="1"
                                                   Symbol="{Binding TypeIcon}"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource Theme.Accent}"
                                                   VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PreviewText}"
                                                   Foreground="{DynamicResource Theme.Text}"
                                                   FontSize="14"
                                                   LineHeight="22"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="48" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <ui:SymbolIcon Symbol="Pin24"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Theme.Pin}"
                                                           Margin="0,0,5,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding TypeLabel}"
                                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                                       FontSize="11" />
                                            <TextBlock Text=" · "
                                                       Foreground="{DynamicResource Theme.TextMuted}"
                                                       FontSize="11"
                                                       Visibility="{Binding HasSizeText, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding SizeText}"
                                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                                       FontSize="11"
                                                       Visibility="{Binding HasSizeText, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text=" · " Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" />
                                            <TextBlock Text="{Binding TimeText}"
                                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 快捷动作（悬停条目时显示） -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=ItemCard}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:Button Appearance="Transparent"
                                                   Padding="5"
                                                   Margin="2,0"
                                                   CornerRadius="6"
                                                   ToolTip="{Binding QrActionToolTip}"
                                                   Visibility="{Binding ShowQrAction, Converter={StaticResource BoolToVis}}"
                                                   Click="OnQrClicked"
                                                   MouseEnter="OnQrButtonMouseEnter"
                                                   MouseLeave="OnQrButtonMouseLeave">
                                            <ui:SymbolIcon Symbol="{Binding QrActionIcon}" FontSize="15" />
                                        </ui:Button>
                                        <ui:Button Appearance="Transparent"
                                                   Padding="5"
                                                   Margin="2,0"
                                                   CornerRadius="6"
                                                   ToolTip="复制"
                                                   Click="OnCopyClicked">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="15" />
                                        </ui:Button>
                                        <ui:Button Appearance="Transparent"
                                                   Padding="5"
                                                   Margin="2,0"
                                                   CornerRadius="6"
                                                   ToolTip="OCR"
                                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                                   Click="OnOcrClicked">
                                            <ui:SymbolIcon Symbol="ScanText24" FontSize="15" />
                                        </ui:Button>
                                        <ui:Button Appearance="Transparent"
                                                   Padding="5"
                                                   Margin="2,0"
                                                   CornerRadius="6"
                                                   ToolTip="置顶"
                                                   Click="OnPinClicked">
                                            <ui:SymbolIcon Symbol="Pin24" FontSize="15" />
                                        </ui:Button>
                                        <ui:Button Appearance="Transparent"
                                                   Padding="5"
                                                   Margin="2,0"
                                                   CornerRadius="6"
                                                   ToolTip="删除"
                                                   Click="OnDeleteClicked">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="56,8,0,0"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="#0DFFFFFF"
                                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding Thumbnail}"
                                           MaxHeight="170"
                                           Stretch="Uniform"
                                           Margin="4" />
                                </Border>
                            </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="24,0"
                    Visibility="{Binding EmptyVisibility}">
            <ui:SymbolIcon Symbol="ClipboardTextLtr24"
                           FontSize="40"
                           Foreground="{DynamicResource Theme.TextMuted}"
                           HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyHint}"
                       Margin="0,16,0,0"
                       Foreground="{DynamicResource Theme.TextSecondary}"
                       FontSize="13.5"
                       LineHeight="22"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="280" />
        </StackPanel>
        </Grid>

        <!-- 底部状态栏与帮助 -->
        <Border Grid.Row="3" Margin="16,2,16,10" Padding="12,6" CornerRadius="8"
                Background="{DynamicResource Theme.Card}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1">
            <Grid>
                <TextBlock Foreground="{DynamicResource Theme.TextSecondary}"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusText}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button x:Name="HelpTipButton"
                           Appearance="Transparent"
                           Padding="4,2"
                           CornerRadius="6"
                           ToolTip="快捷键提示">
                    <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="15"
                                   Foreground="{DynamicResource Theme.TextSecondary}" />
                </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 悬浮预览：颜色由 ApplyHoverPreviewTheme 按当前主题刷（Popup 本地值需跟主题刷新） -->
        <Popup x:Name="PreviewPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               Focusable="False">
            <Grid x:Name="PreviewRoot"
                  MouseEnter="OnPreviewMouseEnter"
                  MouseLeave="OnPreviewMouseLeave">
                <Border x:Name="PreviewBorder"
                        CornerRadius="12"
                        BorderThickness="1"
                        Padding="16,12"
                        MaxWidth="480"
                        MinWidth="160">
                    <Border.Effect>
                        <DropShadowEffect x:Name="PreviewShadow"
                                          BlurRadius="24"
                                          ShadowDepth="3"
                                          Direction="270"
                                          Opacity="0.45"
                                          Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon x:Name="PreviewTypeIcon"
                                           Symbol="{Binding TypeIcon}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaType"
                                       Text="{Binding TypeLabel}"
                                       FontSize="11"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaDot1"
                                       Text=" · "
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaTime"
                                       Text="{Binding TimeText}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaDot2"
                                       Text=" · "
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaSize"
                                       Text="{Binding SizeText}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- 普通悬停：图片缩略 / 文本全文 -->
                        <Image x:Name="PreviewHoverImage"
                               Source="{Binding HoverThumbnail}"
                               MaxWidth="440"
                               MaxHeight="300"
                               Stretch="Uniform"
                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                        <Border x:Name="PreviewQrDecodePanel"
                                Margin="0,12,0,0"
                                Padding="10,8,10,8"
                                CornerRadius="8"
                                Visibility="Collapsed">
                            <Grid>
                                <Border x:Name="PreviewQrDecodeBar"
                                        Width="3"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch" />
                                <StackPanel Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="PreviewQrDecodeIcon"
                                                       Symbol="ScanQrCode24"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />
                                        <TextBlock x:Name="PreviewQrDecodeLabel"
                                                   Text="已识别二维码"
                                                   FontSize="11"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ScrollViewer x:Name="PreviewQrDecodeScroll"
                                                  Margin="0,6,0,0"
                                                  MaxHeight="140"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="PreviewQrDecodeText"
                                                   Text="{Binding QrText}"
                                                   FontSize="13"
                                                   LineHeight="20"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="400" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="PreviewScroll"
                                      MaxHeight="340"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsTextual, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="PreviewBodyText"
                                       Text="{Binding HoverText}"
                                       MaxWidth="440"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="21" />
                        </ScrollViewer>
                        <!-- 悬停二维码按钮：预览切换为二维码图 -->
                        <StackPanel x:Name="PreviewQrPanel"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center">
                            <Image x:Name="PreviewQrImage"
                                   MaxWidth="220"
                                   MaxHeight="220"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center" />
                            <TextBlock x:Name="PreviewQrCaption"
                                       Margin="0,10,0,0"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="240"
                                       Visibility="Collapsed"
                                       Text="" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>

        <!-- 二维码覆盖层 -->
        <Grid x:Name="QrOverlay"
              Grid.RowSpan="4"
              Background="#D8000000"
              Visibility="Collapsed">
            <Border Width="400"
                    Padding="28,24"
                    Background="{DynamicResource Theme.Card}"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="二维码"
                               Foreground="{DynamicResource Theme.Text}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <Image x:Name="QrImage"
                           Width="300"
                           Height="300"
                           Stretch="Uniform"
                           Margin="0,14" />
                    <TextBlock x:Name="QrTextBlock"
                               MaxHeight="64"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               FontSize="12"
                               TextAlignment="Center"
                               Visibility="Collapsed" />
                    <ui:Button Appearance="Primary"
                               Margin="0,14,0,0"
                               Height="36"
                               Content="关闭"
                               Click="OnCloseOverlays" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- OCR 结果覆盖层：尺寸跟主窗口走，避免比列表还宽被裁切 -->
        <Grid x:Name="OcrOverlay"
              Grid.RowSpan="4"
              Background="#D8000000"
              Visibility="Collapsed">
            <Border x:Name="OcrDialog"
                    Margin="14"
                    Padding="20,16"
                    MaxWidth="432"
                    Background="{DynamicResource Theme.Card}"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1"
                    CornerRadius="18"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="OcrTitle"
                               Text="离线识别"
                               Foreground="{DynamicResource Theme.Text}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <TextBox x:Name="OcrText"
                             Grid.Row="1"
                             MinHeight="120"
                             Margin="0,12"
                             Padding="10"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Foreground="{DynamicResource Theme.Text}"
                             Background="{DynamicResource Theme.Search}"
                             BorderBrush="{DynamicResource Theme.Border}"
                             IsReadOnly="True" />
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ui:Button Appearance="Primary"
                                   Height="36"
                                   MinWidth="120"
                                   Margin="6,0"
                                   Content="复制文字"
                                   Click="OnCopyOcrClicked" />
                        <ui:Button Appearance="Secondary"
                                   Height="36"
                                   MinWidth="120"
                                   Margin="6,0"
                                   Content="关闭"

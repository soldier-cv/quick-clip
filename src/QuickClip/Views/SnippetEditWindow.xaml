<ui:FluentWindow x:Class="QuickClip.Views.SnippetEditWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="编辑常用短语"
                  Width="420" Height="460"
                  WindowStartupLocation="CenterOwner"
                  ResizeMode="NoResize"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None"
                  Background="{DynamicResource Theme.Panel}"
                  BorderBrush="{DynamicResource Theme.Border}"
                  BorderThickness="1"
                  KeyDown="OnWindowKeyDown">

    <Grid Background="{DynamicResource Theme.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="常用短语设置"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <StackPanel Grid.Row="1" Margin="20,10,20,10">
            <!-- 标题 -->
            <TextBlock Text="短语标题" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" Margin="0,0,0,6" />
            <ui:TextBox x:Name="TitleBox"
                        Height="34"
                        PlaceholderText="例如：客服落款、常用代码、公司税号"
                        Background="{DynamicResource Theme.Search}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        Foreground="{DynamicResource Theme.Text}"
                        Margin="0,0,0,12" />

            <!-- 分类 -->
            <TextBlock Text="分类" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" Margin="0,0,0,6" />
            <ComboBox x:Name="CategoryCombo"
                      IsEditable="True"
                      Height="34"
                      Background="{DynamicResource Theme.Search}"
                      BorderBrush="{DynamicResource Theme.Border}"
                      Foreground="{DynamicResource Theme.Text}"
                      Margin="0,0,0,12">
                <ComboBoxItem Content="通用" />
                <ComboBoxItem Content="代码" />
                <ComboBoxItem Content="办公" />
                <ComboBoxItem Content="回复" />
                <ComboBoxItem Content="账号" />
            </ComboBox>

            <!-- 正文内容 -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="短语内容" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource Theme.Accent}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Cursor="Hand">
                    <Run Text="支持动态占位符 ℹ" />
                    <TextBlock.ToolTip>
                        <ToolTip Content="支持的占位符（不区分大小写）：&#x0a;• {date} : 当前日期 (如 2026-09-19)&#x0a;• {time} : 当前时间 (如 12:30:00)&#x0a;• {datetime} : 完整日期时间 (yyyy-MM-dd HH:mm:ss)&#x0a;• {year} / {month} / {day} : 年 / 月 / 日&#x0a;• {weekday} / {week} : 星期几 / 周几 (如 星期六 / 周六)&#x0a;• {timestamp} / {timestamp_ms} : 秒级 / 毫秒级时间戳&#x0a;• {guid} / {uuid} : 标准唯一标识符 (含横杠)&#x0a;• {guid_n} : 32位无横杠唯一标识符&#x0a;• {clipboard} : 当前剪贴板内容&#x0a;• {username} : 当前操作系统用户名&#x0a;• {computername} : 当前计算机名&#x0a;• {random4} / {random6} : 4位 / 6位随机验证数字" />
                    </TextBlock.ToolTip>
                </TextBlock>
            </Grid>
            <TextBox x:Name="ContentBox"
                     Height="140"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="8"
                     FontSize="12"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     Background="{DynamicResource Theme.Search}"
                     BorderBrush="{DynamicResource Theme.Border}"
                     BorderThickness="1"
                     Foreground="{DynamicResource Theme.Text}"
                     CaretBrush="{DynamicResource Theme.Text}" />
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{DynamicResource Theme.Search}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Secondary" Content="取消" Width="76" Margin="0,0,10,0" Click="OnCancelClicked" />
                <ui:Button Appearance="Primary" Content="保存" Width="76" Click="OnSaveClicked" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

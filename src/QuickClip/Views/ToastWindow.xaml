<Window x:Class="QuickClip.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="QuickClip Toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Grid Margin="12">
        <Border x:Name="RootCard"
                Background="{DynamicResource Theme.Panel}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Width="460"
                Cursor="Hand"
                MouseEnter="OnMouseEnter"
                MouseLeave="OnMouseLeave"
                MouseLeftButtonDown="OnMouseLeftButtonDown"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="10" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.28" />
            </Border.Effect>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon x:Name="IconElement"
                               Symbol="Info24"
                               FontSize="20"
                               Foreground="{DynamicResource Theme.Accent}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Text}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<ui:FluentWindow x:Class="QuickClip.Views.SnippetEditWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="编辑常用短语"
                  Width="450" Height="560"
                  WindowStartupLocation="CenterScreen"
                  Topmost="True"
                  ResizeMode="NoResize"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None"
                  Background="{DynamicResource Theme.Panel}"
                  BorderBrush="{DynamicResource Theme.Border}"
                  BorderThickness="1"
                  KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style x:Key="PlaceholderBadgeButton" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="Background" Value="{DynamicResource Theme.Search}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="常用短语设置"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <StackPanel Grid.Row="1" Margin="20,10,20,10">
            <!-- 标题 -->
            <TextBlock Text="短语标题" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" Margin="0,0,0,6" />
            <ui:TextBox x:Name="TitleBox"
                        Height="34"
                        PlaceholderText="例如：客服落款、常用代码、公司税号"
                        Background="{DynamicResource Theme.Search}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        Foreground="{DynamicResource Theme.Text}"
                        Margin="0,0,0,12" />

            <!-- 分类 -->
            <TextBlock Text="分类" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" Margin="0,0,0,6" />
            <ComboBox x:Name="CategoryCombo"
                      Height="34"
                      VerticalContentAlignment="Center"
                      Background="{DynamicResource Theme.Search}"
                      BorderBrush="{DynamicResource Theme.Border}"
                      Foreground="{DynamicResource Theme.Text}"
                      Margin="0,0,0,12">
                <ComboBoxItem Content="通用" />
                <ComboBoxItem Content="代码" />
                <ComboBoxItem Content="办公" />
                <ComboBoxItem Content="回复" />
                <ComboBoxItem Content="账号" />
            </ComboBox>

            <!-- 动态占位符常驻信息与快捷插入区 -->
            <Border Margin="0,0,0,8"
                    Padding="8,6"
                    Background="{DynamicResource Theme.Card}"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="点击插入动态占位符（粘贴时自动计算）："
                               FontSize="11"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               Margin="0,0,0,5" />
                    <WrapPanel>
                        <!-- 日期时间类 -->
                        <Button Tag="{}{date}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{date} 日期" ToolTip="当前日期&#x0a;示例：2026-09-20" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{time}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{time} 时间" ToolTip="当前时间&#x0a;示例：14:30:00" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{datetime}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{datetime} 日期时间" ToolTip="完整日期时间&#x0a;示例：2026-09-20 14:30:00" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{year}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{year} 年份" ToolTip="当前年份&#x0a;示例：2026" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{month}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{month} 月份" ToolTip="当前月份（两位）&#x0a;示例：09" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{day}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{day} 日" ToolTip="当前日（两位）&#x0a;示例：20" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{weekday}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{weekday} 星期" ToolTip="中文星期几&#x0a;示例：星期日" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{week}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{week} 周几" ToolTip="简写周几&#x0a;示例：周日" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{timestamp}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{timestamp} 秒级时间戳" ToolTip="10位 Unix 秒级时间戳&#x0a;示例：1789892550" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{timestamp_ms}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{timestamp_ms} 毫秒时间戳" ToolTip="13位 Unix 毫秒时间戳&#x0a;示例：1789892550123" Click="OnPlaceholderBadgeClicked" />

                        <!-- 系统与环境类 -->
                        <Button Tag="{}{clipboard}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{clipboard} 剪贴板" ToolTip="动态读取当前系统剪贴板文本&#x0a;示例：当前剪贴板内容" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{user}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{user} 用户名" ToolTip="当前操作系统用户名&#x0a;示例：Admin" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{device}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{device} 计算机名" ToolTip="当前计算机设备名&#x0a;示例：DESKTOP-PC" Click="OnPlaceholderBadgeClicked" />

                        <!-- 唯一标识与随机数类 -->
                        <Button Tag="{}{guid}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{guid} 唯一ID" ToolTip="全新标准 GUID（含横杠）&#x0a;示例：c9a646d3-9c61-4cb7-bf86-64b55c1f0ff3" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{guid_n}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{guid_n} 32位ID" ToolTip="32位无横杠唯一ID&#x0a;示例：c9a646d39c614cb7bf8664b55c1f0ff3" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{random4}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{random4} 4位随机数" ToolTip="4位随机数字&#x0a;示例：5821" Click="OnPlaceholderBadgeClicked" />
                        <Button Tag="{}{random6}" Style="{StaticResource PlaceholderBadgeButton}" Content="{}{random6} 6位随机数" ToolTip="6位随机数字&#x0a;示例：839201" Click="OnPlaceholderBadgeClicked" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 正文内容 -->
            <TextBlock Text="短语内容" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" Margin="0,0,0,6" />
            <TextBox x:Name="ContentBox"
                     Height="120"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="8"
                     FontSize="12"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     Background="{DynamicResource Theme.Search}"
                     BorderBrush="{DynamicResource Theme.Border}"
                     BorderThickness="1"
                     Foreground="{DynamicResource Theme.Text}"
                     CaretBrush="{DynamicResource Theme.Text}" />
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{DynamicResource Theme.Search}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Secondary" Content="取消" Width="76" Margin="0,0,10,0" Click="OnCancelClicked" />
                <ui:Button Appearance="Secondary"
                           Content="保存"
                           Width="76"
                           FontWeight="SemiBold"
                           BorderBrush="{DynamicResource Theme.Accent}"
                           BorderThickness="1"
                           Foreground="{DynamicResource Theme.Accent}"
                           Click="OnSaveClicked" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

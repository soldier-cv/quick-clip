<!--
  设置窗不用 FluentWindow：其默认铬/客户区在部分环境下会露白边、白槽。
  改用普通 Window + WindowChrome 自绘标题栏，客户区全程 Theme.Panel。
-->
<Window x:Class="QuickClip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuickClip 设置"
        Width="540"
        Height="720"
        MinWidth="400"
        MinHeight="420"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Theme.Panel}"
        BorderBrush="{DynamicResource Theme.Border}"
        BorderThickness="1"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 单层外框：避免 Window + 内 Border 双边框吃高度/露色带 -->
    <Grid x:Name="RootGrid" Background="{DynamicResource Theme.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（可拖拽；关闭钮排除在标题拖拽区外） -->
        <Grid Grid.Row="0" Background="{DynamicResource Theme.Panel}">
            <TextBlock Text="QuickClip 设置"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Text}" />
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="46"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnCloseClicked"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="关闭">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Theme.TextSecondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FF4444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!--
          双列主题 ScrollViewer：内容撑高（如 OCR 引擎面板展开）时 extent 跟随，
          滚动条列 Auto 宽（约 6px，隐藏时为 0），不再留死白/黑条。
        -->
        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="1"
                      Background="{DynamicResource Theme.Panel}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="22,8,12,28"
                      CanContentScroll="False"
                      Focusable="False"
                      Template="{StaticResource ThemeOverlayScrollViewer}">
            <StackPanel Background="{DynamicResource Theme.Panel}"
                        Margin="0,0,0,12">

                <!-- ========== 快捷键 ========== -->
                <!-- ========== 外观 ========== -->
                <TextBlock Text="外观"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,8,0,10" />
                <Border Padding="16,14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeBox"
                                      Grid.Column="1"
                                      Height="36"
                                      SelectionChanged="OnThemeChanged"
                                      PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="16" Height="16"
                                                    CornerRadius="4"
                                                    Margin="0,0,10,0"
                                                    BorderBrush="{DynamicResource Theme.Border}"
                                                    BorderThickness="1"
                                                    Background="{Binding Swatch}" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Theme.Text}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="快捷键"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10" />

                <Border Padding="0"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>

                        <!-- 分区：全局 -->
                        <TextBlock Text="全局"
                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="16,14,16,6" />

                        <!-- 系统剪贴板接管（含固定 Win+V 唤起面板；不可改键） -->
                        <Grid Margin="16,4,16,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="系统剪贴板接管"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Height="34"
                                    Padding="10,0"
                                    CornerRadius="4"
                                    Background="{DynamicResource Theme.Search}"
                                    BorderBrush="{DynamicResource Theme.Border}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="SysClipboardStatusBadge"
                                            Padding="6,2"
                                            CornerRadius="4"
                                            Background="{DynamicResource Theme.AccentMuted}"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="SysClipboardStatusText"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.Accent}"
                                                   Text="已自动彻底接管" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="SysClipboardHintText"
                                   Margin="184,2,16,6"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   FontSize="11.5"
                                   LineHeight="16"
                                   TextWrapping="Wrap"
                                   Text="Win+V 固定唤起面板；系统剪贴板历史已释放，由 QuickClip 独占接管。" />

                        <Rectangle Height="1" Fill="#12FFFFFF" Margin="16,8,16,8" />

                        <!-- 全局纯文本粘贴：固定 Ctrl+Shift+V，仅启用/禁用 -->
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="全局纯文本粘贴"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Height="34"
                                    Padding="10,0"
                                    CornerRadius="4"
                                    Background="{DynamicResource Theme.Search}"
                                    BorderBrush="{DynamicResource Theme.Border}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + Shift + V"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <CheckBox x:Name="PlainPasteEnabledCheck"
                                  Margin="184,2,16,4"
                                  Foreground="{DynamicResource Theme.TextSecondary}"
                                  FontSize="12"
                                  Content="启用此全局热键"
                                  Checked="OnPlainPasteEnabledToggled"
                                  Unchecked="OnPlainPasteEnabledToggled" />

                        <!-- 分区：面板内 -->
                        <Rectangle Height="1" Fill="#12FFFFFF" Margin="16,10,16,4" />
                        <TextBlock Text="面板内"
                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="16,8,16,6" />

                        <!-- 粘贴选中 -->
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="粘贴选中项"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="PasteSelectedBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="10,0"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="Transparent"
                                     Tag="PasteSelected"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus" />
                            <ui:Button Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="12,0"
                                       Content="默认"
                                       Tag="PasteSelected"
                                       Click="OnResetHotkeyClicked" />
                        </Grid>

                        <!-- 纯文本粘贴选中 -->
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="纯文本粘贴选中项"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="PasteSelectedPlainBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="10,0"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="Transparent"
                                     Tag="PasteSelectedPlain"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus" />
                            <ui:Button Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="12,0"
                                       Content="默认"
                                       Tag="PasteSelectedPlain"
                                       Click="OnResetHotkeyClicked" />
                        </Grid>

                        <!-- 窗口置顶（产品热键，可改） -->
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="窗口置顶 / 取消"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="TogglePinBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="10,0"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="Transparent"
                                     Tag="TogglePin"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus" />
                            <ui:Button Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="12,0"
                                       Content="默认"
                                       Tag="TogglePin"
                                       Click="OnResetHotkeyClicked" />
                        </Grid>

                        <!-- 仅在捕获快捷键出错 / 成功改绑时显示 -->
                        <TextBlock x:Name="HotkeyHintText"
                                   Margin="16,6,16,14"
                                   Foreground="{DynamicResource Theme.Accent}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ========== 通用 ========== -->
                <TextBlock Text="通用"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10" />
                <Border Padding="16,14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartCheck"
                                  Foreground="{DynamicResource Theme.TextSecondary}"
                                  FontSize="13"
                                  Content="开机自启动"
                                  Checked="OnAutoStartToggled"
                                  Unchecked="OnAutoStartToggled" />
                        <CheckBox x:Name="AutoCheckUpdatesCheck"
                                  Margin="0,10,0,0"
                                  Foreground="{DynamicResource Theme.TextSecondary}"
                                  FontSize="13"
                                  Content="自动检查并下载更新"
                                  Checked="OnAutoCheckUpdatesToggled"
                                  Unchecked="OnAutoCheckUpdatesToggled" />
                    </StackPanel>
                </Border>

                <!-- ========== OCR：下拉选引擎，默认系统离线 ========== -->
                <TextBlock Text="OCR 识别"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10" />
                <Border Padding="16,14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="识别引擎"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="OcrEngineBox"
                                      Grid.Column="1"
                                      Height="34"
                                      SelectionChanged="OnOcrEngineChanged"
                                      PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                <ComboBoxItem Content="系统自带" />
                                <ComboBoxItem Content="离线模型（PP-OCRv6）" />
                                <ComboBoxItem Content="OpenAI 兼容" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="OcrEngineHint"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap" />

                        <StackPanel x:Name="LocalOcrPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <StackPanel.Resources>
                                <Style x:Key="OcrDownloadProgressBar" TargetType="ProgressBar">
                                    <Setter Property="Height" Value="6" />
                                    <Setter Property="Minimum" Value="0" />
                                    <Setter Property="Maximum" Value="100" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <!-- PART_Track 必须存在，否则 Value 不会驱动指示条宽度 -->
                                                <Border x:Name="PART_Track"
                                                        Background="{DynamicResource Theme.Border}"
                                                        CornerRadius="3"
                                                        Height="6">
                                                    <Border x:Name="PART_Indicator"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource Theme.Accent}"
                                                            CornerRadius="3" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="选择模型包"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,0,8" />

                            <Border x:Name="OcrPackSmallCard"
                                    Padding="12,10"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    BorderThickness="1"
                                    Background="{DynamicResource Theme.Search}"
                                    BorderBrush="{DynamicResource Theme.Border}"
                                    MouseLeftButtonUp="OnOcrPackCardClicked"
                                    Tag="Small">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="均衡"
                                                       Foreground="{DynamicResource Theme.Text}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="PP-OCRv6 Small"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="约 30 MB · 识别 81.3% · 检测 84.1%"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource Theme.TextMuted}"
                                                   FontSize="11.5" />
                                        <TextBlock Text="日常截图够用"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                                   FontSize="11.5" />
                                        <TextBlock x:Name="OcrPackSmallStatus"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource Theme.TextMuted}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button x:Name="OcrPackSmallButton"
                                               Grid.Column="1"
                                               Appearance="Secondary"
                                               Height="32"
                                               Padding="12,0"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Content="下载"
                                               Tag="Small"
                                               Click="OnOcrPackActionClicked" />
                                    <ProgressBar x:Name="OcrPackSmallProgress"
                                                 Grid.Row="1"
                                                 Grid.ColumnSpan="2"
                                                 Margin="0,8,0,0"
                                                 Style="{StaticResource OcrDownloadProgressBar}" />
                                </Grid>
                            </Border>

                            <Border x:Name="OcrPackMediumCard"
                                    Margin="0,8,0,0"
                                    Padding="12,10"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    BorderThickness="1"
                                    Background="{DynamicResource Theme.Search}"
                                    BorderBrush="{DynamicResource Theme.Border}"
                                    MouseLeftButtonUp="OnOcrPackCardClicked"
                                    Tag="Medium">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="高精度"
                                                       Foreground="{DynamicResource Theme.Text}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Border Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource Theme.AccentMuted}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="推荐"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Theme.Accent}" />
                                            </Border>
                                            <TextBlock Text="PP-OCRv6 Medium"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="约 132 MB · 识别 83.2% · 检测 86.2%"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource Theme.TextMuted}"
                                                   FontSize="11.5" />
                                        <TextBlock Text="屏幕、混排更稳"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                                   FontSize="11.5" />
                                        <TextBlock x:Name="OcrPackMediumStatus"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource Theme.TextMuted}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button x:Name="OcrPackMediumButton"
                                               Grid.Column="1"
                                               Appearance="Secondary"
                                               Height="32"
                                               Padding="12,0"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Content="下载"
                                               Tag="Medium"
                                               Click="OnOcrPackActionClicked" />
                                    <ProgressBar x:Name="OcrPackMediumProgress"
                                                 Grid.Row="1"
                                                 Grid.ColumnSpan="2"
                                                 Margin="0,8,0,0"
                                                 Style="{StaticResource OcrDownloadProgressBar}" />
                                </Grid>
                            </Border>

                            <Border x:Name="OcrPackCustomCard"
                                    Margin="0,8,0,0"
                                    Padding="12,10"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    BorderThickness="1"
                                    Background="{DynamicResource Theme.Search}"
                                    BorderBrush="{DynamicResource Theme.Border}"
                                    MouseLeftButtonUp="OnOcrPackCardClicked"
                                    Tag="Custom">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="自定义"
                                                   Foreground="{DynamicResource Theme.Text}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="自备 det + rec + 字典"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="大小按目录实际占用 · 精度自备"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource Theme.TextMuted}"
                                               FontSize="11.5" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OcrCustomDirBox"
                                                 Height="34"
                                                 Padding="10,0"
                                                 VerticalContentAlignment="Center"
                                                 LostFocus="OnOcrCustomDirLostFocus" />
                                        <ui:Button Grid.Column="1"
                                                   Appearance="Secondary"
                                                   Height="34"
                                                   Padding="12,0"
                                                   Margin="8,0,0,0"
                                                   Content="浏览"
                                                   Click="OnOcrCustomBrowseClicked" />
                                    </Grid>
                                    <TextBlock x:Name="OcrPackCustomStatus"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource Theme.TextMuted}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="OcrLocalActiveHint"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="VisionApiPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="接口地址"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="VisionApiUrlBox"
                                         Grid.Column="1"
                                         Height="34"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         LostFocus="OnVisionApiConfigLostFocus" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="视觉模型"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="VisionApiModelBox"
                                         Grid.Column="1"
                                         Height="34"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         LostFocus="OnVisionApiConfigLostFocus" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <PasswordBox x:Name="VisionApiKeyBox"
                                             Grid.Column="1"
                                             Height="34"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             LostFocus="OnVisionApiConfigLostFocus" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="OcrTestPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="OcrTestButton"
                                           Appearance="Secondary"
                                           Height="34"
                                           Padding="14,0"
                                           Content="测试接口"
                                           Click="OnOcrTestClicked" />
                            </StackPanel>
                            <TextBlock x:Name="OcrTestStatus"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 高级 ========== -->
                <TextBlock Text="高级"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10" />
                <Border Padding="16,14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="TextOnlyCheck"
                                  Foreground="{DynamicResource Theme.TextSecondary}"
                                  FontSize="13"
                                  Content="仅记录文本（忽略图片/文件）"
                                  Checked="OnTextOnlyToggled"
                                  Unchecked="OnTextOnlyToggled" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最大条数"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="MaxHistoryBox"
                                     Grid.Column="1"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     LostFocus="OnMaxHistoryLostFocus" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== 关于 ========== -->
                <TextBlock Text="关于"
                           Foreground="{DynamicResource Theme.Text}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10" />
                <Border Padding="16,14"
                        CornerRadius="12"
                        Background="{DynamicResource Theme.Card}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="QuickClip · 版本 "
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="VersionText"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ChannelText"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource Theme.TextMuted}"
                                   FontSize="12" />
                        <TextBlock x:Name="UpdateStatusText"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Appearance="Secondary"
                                       Height="34"
                                       Padding="14,0"
                                       Content="打开数据目录"
                                       Click="OnOpenDataFolderClicked" />
                            <ui:Button x:Name="CheckUpdateButton"
                                       Margin="10,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="14,0"
                                       Content="检查更新…"
                                       Click="OnCheckUpdateClicked" />
                            <ui:Button x:Name="InstallUpdateButton"
                                       Margin="10,0,0,0"
                                       Appearance="Primary"
                                       Height="34"
                                       Padding="14,0"
                                       Content="立即更新"
                                       Visibility="Collapsed"
                                       Click="OnInstallUpdateClicked" />
                            <ui:Button x:Name="BrowserDownloadButton"
                                       Margin="10,0,0,0"
                                       Appearance="Secondary"
                                       Height="34"
                                       Padding="14,0"
                                       Content="在浏览器中下载"
                                       Visibility="Collapsed"
                                       Click="OnBrowserDownloadClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
